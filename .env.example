# Application Configuration
DEBUG=false
ENV=local

# PostgreSQL Configuration
POSTGRES_USER=ledgerlite
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ledgerlite
DATABASE_URL=postgresql+asyncpg://ledgerlite:change-me@postgres:5432/ledgerlite

# Payment Provider Configuration (shared by wallet-service and provider-mock)
PROVIDER_BASE_URL=http://provider-mock:80
PROVIDER_API_KEY=change-me-provider-api-key
PROVIDER_WEBHOOK_SECRET=change-me-webhook-secret
PROVIDER_TIMEOUT_SECONDS=5
PROVIDER_PUBLIC_URL=http://localhost:8081

# Wallet Service Configuration
WALLET_CALLBACK_URL=http://wallet-service:80/v1/webhooks/provider
WEBHOOK_TOLERANCE_SECONDS=300
RATE_LIMIT_PER_MINUTE=30
